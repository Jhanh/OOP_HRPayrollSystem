*.class

# Build / Output directories
bin/
build/
target/
out/
dist/

# Archive files (nhưng vẫn giữ lại file JAR trong thư mục lib/)
*.zip
*.tar.gz
*.rar
*.7z

# Eclipse IDE
.metadata/
.recommenders/
.settings/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.history/

# Hệ điều hành (OS generated files)
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes

# Log files & Crash dumps
*.log
hs_err_pid*.log
replay_pid*.log

# Runtime generated / Exported test files (Phiếu lương tạm thời, etc.)
exports/
temp/
